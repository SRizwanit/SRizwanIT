{
  "name": "rizwan-intro-video",
  "version": "1.0.0",
  "private": true,
  "description": "Rizwan Chowdhury - ~35s intro video (Remotion)",
  "scripts": {
    "start": "remotion studio index.ts",
    "render:hd": "remotion render index.ts Intro out-HD.mp4 --codec=h264 --crf=14",
    "render:4k": "remotion render index.ts Intro out-4K.mp4 --codec=h264 --crf=15 --scale=2",
    "render:vertical": "remotion render index.ts IntroVertical out-Vertical-HD.mp4 --codec=h264 --crf=14",
    "still": "remotion still index.ts Intro out-still.png --frame=150",
    "render:feed": "remotion render index.ts IntroFeed out-Feed-HD.mp4 --codec=h264 --crf=14",
    "cover:wide": "remotion still index.ts CoverWide cover-wide.png",
    "cover:vertical": "remotion still index.ts CoverVertical cover-vertical.png",
    "cover:feed": "remotion still index.ts CoverFeed cover-feed.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "@remotion/transitions": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
